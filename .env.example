# ------------------------------------------------------------------
# Medical AI Consultation Chatbot — root environment
# Copy to .env and fill in values. Never commit real secrets.
# ------------------------------------------------------------------

# --- MongoDB (apps/api, services/ai, database scripts) ---
MONGODB_URI=mongodb://localhost:27017/medchat
MONGODB_DB=medchat 

# --- Node/Express API (apps/api) ---
PORT=5001
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-secret~
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
# Base URL of the FastAPI AI service
AI_SERVICE_URL=http://localhost:8000
# Shared secret so the API can authenticate to the AI service
AI_SERVICE_API_KEY=change-me-ai-service-key
# Where uploaded doctor documents are stored while being processed
UPLOAD_DIR=./uploads

# --- FastAPI AI service (services/ai) ---
AI_SERVICE_PORT=8000
# Secret the API must send in the X-AI-Key header
API_KEY_FOR_AI=change-me-ai-service-key
# Ollama inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Local embedding model (Ollama or sentence-transformers)
EMBEDDING_MODEL=bge-m3
# How many RAG chunks to retrieve per query
RAG_TOP_K=5
# Local Whisper speech-to-text for consultation audio (multilingual / Hinglish)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- FastAPI ML Prediction service (services/ml) ---
ML_SERVICE_PORT=8001
# Directory containing the trained .pkl models
ML_MODELS_DIR=./ml-models

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:5001
